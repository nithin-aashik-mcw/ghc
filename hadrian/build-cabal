#!/usr/bin/env bash

CABAL="${CABAL:-cabal}"
GHC="${GHC:-ghc}"
CABFLAGS=("--with-compiler=$GHC" "--disable-documentation" "--disable-profiling" "--disable-library-profiling" $CABFLAGS)
( $GHC --info | grep -s '("Support SMP","YES")' > /dev/null ) || CABFLAGS+=("--constraint=hadrian -threaded")

# It is currently more robust to pass Cabal an absolute path to the project file.
PROJ="$PWD/hadrian/cabal.project"

set -euo pipefail

if ! [ -f "$PROJ" ]; then
    echo "Current working directory must be GHC's top-level folder"
    exit 2
fi

if ! type "$CABAL" > /dev/null; then
    echo "Please make sure 'cabal' is in your PATH"
    exit 2
fi

CABVERSTR=$("$CABAL" --numeric-version)
CABVER=( ${CABVERSTR//./ } )

# We use 'cabal path', introduced with cabal-install 3.12.
# Check version ahead of time to avoid a surprising failure later (#27317).
if [ "${CABVER[0]}" -lt 3 ] || { [ "${CABVER[0]}" -eq 3 ] && [ "${CABVER[1]}" -lt 12 ]; }; then
    echo "Cabal version is too old; you need at least cabal-install 3.12"
    exit 2
fi

REMOTE_REPO_CACHE=$("$CABAL" --with-compiler="$GHC" path --output-format=key-value 2>/dev/null | awk '/^remote-repo-cache:/ { print $2 }')
if ! [ -d "$REMOTE_REPO_CACHE/hackage.haskell.org" ]; then
    echo "Please run 'cabal update' first"
    exit 2
fi

# On Windows AArch64, the x86_64 helpers that hsc2hs builds and runs (such as
# Clock_hsc_make.exe) are briefly held open by the emulator's translation cache
# after they exit, so cabal can fail to remove its temporary build directory.
# Retry; the packages already built are kept in the store.
attempts=1
if [ "${MSYSTEM:-}" = "CLANGARM64" ]; then attempts=3; fi
for attempt in $(seq "$attempts"); do
    "$CABAL" --project-file="$PROJ" new-build "${CABFLAGS[@]}" -j exe:hadrian && break
    if [ "$attempt" -eq "$attempts" ]; then exit 1; fi
    echo "Building Hadrian failed; retrying ($attempt/$attempts)"
done
# use new-exec instead of new-run to make sure that the build-tools (alex & happy) are in PATH
"$CABAL" --project-file="$PROJ" new-exec  "${CABFLAGS[@]}"    hadrian -- \
    --directory "$PWD" \
    "$@"
